# Elite Marcom website backend — environment configuration
# Copy to .env (or export in your process manager) and fill with real values.
# PLACEHOLDERS ONLY — never commit real secrets.

# development | production  (production fails closed on missing values below)
EM_ENV=development

# Bind address for the app server (keep private behind a reverse proxy in production)
EM_HOST=127.0.0.1
EM_PORT=8847

# Exact allowed origins, comma separated (production: your https:// domain only)
EM_ALLOWED_ORIGINS=http://127.0.0.1:8847,http://localhost:8847

# Reverse-proxy peers allowed to set X-Forwarded-For (comma separated IPs)
EM_TRUSTED_PROXIES=

# --- independent secrets (32+ chars each, all three DISTINCT) ---
EM_DATA_KEY=change-me-32-characters-minimum-data-key
EM_CHALLENGE_SECRET=change-me-32-characters-minimum-challenge
EM_IP_HASH_SECRET=change-me-32-characters-minimum-ip-hash

# --- Cloudflare Turnstile (required in production) ---
EM_TURNSTILE_SITE_KEY=
EM_TURNSTILE_SECRET=

# --- giveaways supplier (Jasani). Token never reaches the browser. ---
JASANI_API_TOKEN=

# --- malware scanning (clamd unix socket; mandatory in production) ---
EM_CLAMD_SOCKET=/var/run/clamav/clamd.ctl

# --- storage & retention ---
EM_RUNTIME_DIR=./runtime
EM_RETENTION_SUBMISSIONS_DAYS=180
EM_RETENTION_CAREERS_DAYS=90
EM_RETENTION_CATALOG_DAYS=30
EM_SUPPLIER_DAILY_BUDGET=400
