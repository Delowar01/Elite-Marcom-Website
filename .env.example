# Elite Marcom website backend — environment configuration
# Copy to .env (or export in your process manager) and fill with real values.
# PLACEHOLDERS ONLY — never commit real secrets.

# development | production  (production fails closed on missing values below)
EM_ENV=development

# Bind address for the app server (keep private behind a reverse proxy in production)
EM_HOST=127.0.0.1
EM_PORT=8847

# Exact allowed origins, comma separated (production: your https:// domain only)
EM_ALLOWED_ORIGINS=http://127.0.0.1:8847,http://localhost:8847

# Reverse-proxy peers allowed to set X-Forwarded-For (comma separated IPs)
EM_TRUSTED_PROXIES=

# --- independent secrets (32+ chars each, all three DISTINCT) ---
EM_DATA_KEY=change-me-32-characters-minimum-data-key
EM_CHALLENGE_SECRET=change-me-32-characters-minimum-challenge
EM_IP_HASH_SECRET=change-me-32-characters-minimum-ip-hash
EM_ADMIN_SESSION_SECRET=change-me-32-characters-minimum-admin
# one-time code required to create the FIRST admin account (production)
EM_ADMIN_SETUP_CODE=
# admin session length in hours
EM_ADMIN_SESSION_HOURS=12

# --- Cloudflare Turnstile (required in production) ---
EM_TURNSTILE_SITE_KEY=
EM_TURNSTILE_SECRET=

# --- giveaways supplier (Jasani). Token never reaches the browser. ---
# one token per market — separate supplier accounts, separate daily allowances.
# There is deliberately no fallback between them: one token serving both markets
# would carry ten calls a day and be answered with a 403.
JASANI_API_TOKEN=            # Saudi Arabia (www.giftsksa.com)
JASANI_API_TOKEN_UAE=        # United Arab Emirates (www.jasani.ae)
# primary calls per market per local day, and how many of them background jobs
# may use — the rest stay reserved for a manual sync by an owner/admin.
# The four automatic calls run at 00:00, 08:00, 13:00 and 18:00 local time.
EM_SUPPLIER_DAILY_BUDGET=5
EM_SUPPLIER_AUTO_BUDGET=4
# seconds to wait on a supplier response. The UAE products feed is ~4 MB and was
# measured from the production VPS at 24.2s, so anything near 20 aborts a valid
# reply. A timed-out call never reached Jasani, so it is refunded, not spent.
EM_SUPPLIER_TIMEOUT_S=60
# hard ceiling on an upstream response, in bytes. The UAE products feed is
# ~4.17 MB today; 8 MB (8388608) leaves room to grow without weakening the cap.
EM_SUPPLIER_MAX_BYTES=8388608

# --- transactional email (Resend) ---
# Server-side only. Never expose this key to the browser and never commit it.
RESEND_API_KEY=
# comma-separated sender domains verified in Resend (the admin panel refuses others)
EM_MAIL_SENDER_DOMAINS=mail.elitemarcom.com

# --- legacy SMTP staff alerts (optional; silent when EM_SMTP_HOST is empty) ---
# Recipients are managed in the admin panel under Settings → notify.emails.
EM_SMTP_HOST=
EM_SMTP_PORT=587
EM_SMTP_USER=
EM_SMTP_PASS=
EM_SMTP_FROM=

# --- malware scanning (clamd unix socket; mandatory in production) ---
EM_CLAMD_SOCKET=/var/run/clamav/clamd.ctl

# --- storage & retention ---
EM_RUNTIME_DIR=./runtime
EM_RETENTION_SUBMISSIONS_DAYS=180
EM_RETENTION_CAREERS_DAYS=90
EM_RETENTION_CATALOG_DAYS=30
# Jasani allows at most 5 primary GET calls (products/price/stock) per UAE day.
# Raise this only if Jasani confirms a higher limit in writing.
EM_SUPPLIER_DAILY_BUDGET=5
# Upstream refresh cadence sized to that budget (hours)
EM_PRODUCT_REFRESH_HOURS=22
EM_STOCK_REFRESH_HOURS=11
